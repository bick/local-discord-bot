# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands instantly in a single test server
DISCORD_DEV_GUILD_ID=

# SeatGeek (https://seatgeek.com/account/develop)
SEATGEEK_CLIENT_ID=

# Postgres. On Railway set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dfw_events

TZ=America/Chicago

# Optional
# BOT_NAME=Big Tex            # bot username, applied on startup
# BOT_OWNER_IDS=             # user IDs allowed to run /avatar (default: the app's owner/team)
# LOG_LEVEL=info
# BOT_LOG_CHANNEL_ID=        # private #bot-logs channel for error alerts
# PORT=                      # set to expose GET /health with gateway status
# POLL_CRON=0 */6 * * *
# DIGEST_CRON=0 17 * * 4
# LOOKAHEAD_DAYS=90
